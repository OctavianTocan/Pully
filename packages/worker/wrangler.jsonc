// The hosted Pully server (plans/12-hosted-server.md): the Rust server built for Workers. Every
// request goes to one PullyServer Durable Object, which keeps the server's data and analytics in
// its SQLite storage; published Android builds are in the pully-android R2 bucket. Claude Code and
// Codex run in one AgentHome container per Pully login, whose sign-in files that object keeps.
// Public browsing and personal GitHub sign-in (/api/public/, /api/personal/) have their own
// PersonalServer object and storage, as the native server has its separate public listener.
// There is no route and no workers.dev or preview URL: the hostname and the Cloudflare Access policy
// in front of it come with Tavi's go-ahead to deploy (CONTRACTS, hosted-server-only-behind-access).
{
  "name": "pully-server",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "worker-build --release" },
  "durable_objects": {
    "bindings": [
      { "name": "PULLY_SERVER", "class_name": "PullyServer" },
      { "name": "AGENT_HOME", "class_name": "AgentHome" },
      { "name": "PERSONAL_SERVER", "class_name": "PersonalServer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PullyServer"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentHome"] },
    { "tag": "v3", "new_sqlite_classes": ["PersonalServer"] }
  ],
  // One container per Pully login, started by its AgentHome object (ai-kit/src/home.rs).
  "containers": [
    {
      "class_name": "AgentHome",
      "image": "./agent/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 20
    }
  ],
  "r2_buckets": [
    { "binding": "PULLY_ANDROID", "bucket_name": "pully-android" }
  ],
  "observability": { "enabled": true }
}

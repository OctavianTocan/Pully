// The hosted Pully server (plans/12-hosted-server.md): this Worker sends every request to one
// PullyServer Durable Object, which runs the Rust server from docker/server/Dockerfile in a
// Cloudflare Container and keeps its data folder in R2. There is no route and no workers.dev or
// preview URL: the hostname and the Cloudflare Access policy in front of it come with Tavi's
// go-ahead to deploy (root CONTRACTS, phone-api-one-account).
{
  "name": "pully-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "KEEP_AWAKE": "true" },
  // Wakes the server after a deploy and keeps its refresh loop running between phone visits.
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "PULLY_SERVER", "class_name": "PullyServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PullyServer"] }],
  "containers": [
    {
      "class_name": "PullyServer",
      "image": "../../docker/server/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "pully-server-data" }],
  "observability": { "enabled": true }
}

// The hosted Pully server (plans/12-hosted-server.md): the Rust server built for Workers. Every
// request goes to one PullyServer Durable Object, which keeps the server's data in its SQLite
// storage. There is no route and no workers.dev or preview URL: the hostname and the Cloudflare
// Access policy in front of it come with Tavi's go-ahead to deploy (CONTRACTS,
// hosted-server-only-behind-access).
{
  "name": "pully-server",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "worker-build --release" },
  "durable_objects": {
    "bindings": [{ "name": "PULLY_SERVER", "class_name": "PullyServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PullyServer"] }],
  "observability": { "enabled": true }
}

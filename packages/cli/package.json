{
  "name": "pulls.review",
  "type": "module",
  "version": "0.2.0",
  "description": "Review local git changes - the working tree, a commit or any range - grouped and summarized in the browser.",
  "author": "Anthony Fu <hi@antfu.me>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://pulls.review",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/pulls.review.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/antfu/pulls.review/issues",
  "keywords": [
    "pull-request",
    "code-review",
    "git"
  ],
  "bin": {
    "pulls.review": "./bin.mjs",
    "pulls-review": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && pnpm -F @pulls.review/app run build:local",
    "dev": "node bin.mjs",
    "typecheck": "node --check bin.mjs && node --check scripts/build.mjs",
    "test": "node --test test/launcher.test.mjs"
  }
}

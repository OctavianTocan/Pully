<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Removing a past version from Settings, Advanced, Past versions. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Only apps signed with this key may open a past version, and each past version is opened with it. -->
    <permission
        android:name="com.octaviantocan.pulls.permission.PAST_UI"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.octaviantocan.pulls.permission.PAST_UI" />

    <!-- The past versions of Pulls, each its own package, found by the category only they answer. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.octaviantocan.pulls.category.PAST_UI" />
        </intent>
        <!-- The GitHub app, so the GitHub links page can tell whether it is there to take the links first. -->
        <package android:name="com.github.android" />
        <!-- Browsers and the GitHub app, so "on GitHub" hands a link to one of them instead of back to Pully (OutsideLinks). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".PullsApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pulls">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
            A tapped GitHub pull request, commit or compare link. Android's pathPattern never backtracks: each ".*" stops at
            the first "/", so one ".*" per path segment is the only form that matches /owner/repo/pull/12 (LinkFilterTest).
            Android 12 and later open github.com links here only once the reader allows it under Open by default, which
            Settings, GitHub links opens. Issues, code and every other GitHub page stay in the browser.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="github.com" />
                <data android:host="www.github.com" />
                <data android:pathPattern="/.*/.*/pull/.*" />
                <data android:pathPattern="/.*/.*/commit/.*" />
                <data android:pathPattern="/.*/.*/compare/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="prs.octaviantocan.com" android:pathPrefix="/" />
            </intent-filter>
            <!-- Share, from Chrome, the GitHub app or anywhere: the shared text only has to contain the link. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Selected text's menu: a link, or owner/repo#12. -->
            <intent-filter android:label="@string/open_in_pulls">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Reader-enabled, URL-only browser helper. No overlay or history permission is requested. -->
        <service
            android:name=".browser.BrowserRepoService"
            android:exported="true"
            android:label="@string/browser_helper_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/browser_helper_service" />
        </service>
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
